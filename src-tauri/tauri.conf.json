{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kompanion",
  "version": "0.1.0",
  "identifier": "com.codex.live-companion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kompanion",
        "width": 980,
        "height": 620,
        "minWidth": 760,
        "minHeight": 520,
        "backgroundColor": "#101110"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$RESOURCE/images/amps/**/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "publisher": "edmei014",
    "copyright": "Kompanion · edmei014 · 2026",
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "resources/images/amps/": "images/amps/"
    },
    "windows": {
      "nsis": {
        "template": "windows/nsis/installer.nsi"
      }
    }
  }
}
