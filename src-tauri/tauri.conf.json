{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kemper Live Companion",
  "version": "0.1.0",
  "identifier": "com.codex.kemper-live-companion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Live Companion for Kemper Profiler v1.0",
        "width": 980,
        "height": 620,
        "minWidth": 760,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
