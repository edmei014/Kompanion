{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kompanion",
  "version": "0.1.0",
  "identifier": "com.codex.live-companion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kompanion",
        "width": 980,
        "height": 620,
        "minWidth": 760,
        "minHeight": 520,
        "backgroundColor": "#101110"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
	"icon": [
    "icons/icon.ico"
	],
    "windows": {
      "nsis": {
        "template": "windows/nsis/installer.nsi"
      }
    }
  }
}
